# Copy this file to .env and adjust values, then `pip install python-dotenv`
# and add `from dotenv import load_dotenv; load_dotenv()` at the top of app.py
# if you want these to be loaded automatically.

SECRET_KEY=change-me-super-secret
JWT_SECRET_KEY=change-me-jwt-secret

DATABASE_PATH=meedicoapp.db

# Comma separated list, or * for any origin
CORS_ORIGINS=*

# SMTP (leave blank to auto fallback to console logging of emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Meedicoapp <no-reply@meedicoapp.local>
MAIL_SUPPRESS_SEND=auto

# Seed / default admin account
ADMIN_EMAIL=admin@meedicoapp.com
ADMIN_PASSWORD=Admin@123
